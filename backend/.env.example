# ─────────────────────────────────────────────
# Halloween Costumes Manager — Backend .env
# Copia este archivo como .env y ajusta valores
# ─────────────────────────────────────────────

# Servidor
PORT=3001
NODE_ENV=development

# Base de datos SQLite (ruta relativa al proceso)
DB_PATH=./data/halloween.db

# CORS: origen(es) del frontend separados por coma
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# OpenAI (opcional — si no se define, el bot usa lógica de reglas)
# OPENAI_API_KEY=sk-...
